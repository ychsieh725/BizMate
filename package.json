{
  "name": "bizmate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "rm -rf .next coverage playwright-report test-results",
    "lint": "eslint",
    "test": "vitest run",
