    "verify:repo": "tsx --env-file=.env.local scripts/verify-repo.ts",
    "verify:gemini": "tsx --env-file=.env.local scripts/verify-gemini.ts",
    "verify:cost": "tsx --env-file=.env.local scripts/verify-cost.ts",
    "verify:pricing": "tsx --env-file=.env.local scripts/verify-pricing.ts",
    "verify:describe": "tsx --env-file=.env.local scripts/verify-describe.ts",
    "verify:parser": "tsx --env-file=.env.local scripts/verify-parser.ts",
    "verify:ratelimit": "tsx --env-file=.env.local scripts/verify-rate-limit.ts",
    "verify:clarification": "tsx --env-file=.env.local scripts/verify-clarification.ts",
    "verify:answer": "tsx --env-file=.env.local scripts/verify-answer.ts",
    "verify:auth": "tsx --env-file=.env.local scripts/verify-auth.ts",
    "verify:services": "tsx --env-file=.env.local scripts/verify-services.ts",
    "verify:quotes": "tsx --env-file=.env.local scripts/verify-quotes.ts",
