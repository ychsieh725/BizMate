    "seed:rate-card": "tsx --env-file=.env.local scripts/seed-rate-card.ts",
    "export:contracts": "tsx scripts/export-shared-contracts.ts",
    "verify:adjustment-metrics": "tsx --env-file=.env.local scripts/verify-adjustment-metrics.ts"
