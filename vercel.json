{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "web": {
      "src": ".",
      "path": "/"
    },
    "agent": {
      "src": "agent-service",
      "path": "/agent-service"
    }
  },
  "functions": {
    "agent-service/app/main.py": {
      "excludeFiles": "{agent-service/eval/**,agent-service/tests/**,agent-service/**/test_*.py,agent-service/.venv/**}"
    }
  }
}
