# BizMate 環境變數範本（SDS §15）
# 複製此檔為 .env.local 並填入實際值；.env.local 已被 gitignore，不會進版控。
# 分階段填入：現在只需要 Supabase 兩項，其餘功能任務啟動時再補。

# ── 核心：現在就需要（任務 2.2 起）─────────────────────────
# Supabase → Project Settings → Data API / API Keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth：任務 5.2（認證基建）起需要 ─────────────────────
# Supabase → Project Settings → API Keys
# NEXT_PUBLIC_SUPABASE_URL 與 SUPABASE_URL 同值
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 本機 dev 商家：seed / verify 腳本需要 ──────────────────
# scripts/dev-merchant.ts 會用這組密碼建立（或登入）slug=dev 的本機商家。
# 這是 Supabase 裡的真實帳號，且本專案開發與 production 共用同一個
# Supabase 專案，故密碼絕不可寫死在原始碼——repo 公開後任何人都能登入。
# 至少 12 字元。產生方式：openssl rand -base64 24
#
# 輪換密碼：改這裡的值，再跑一次 pnpm seed:rate-card 即可——腳本會把既有帳號的
# 密碼同步成此處的值。不要用 Supabase 後台的「寄送重設信」，dev@bizmate.local
# 是保留網域，收不到信。
DEV_MERCHANT_PASSWORD=

# ── LLM：任務 2.5（Gemini client）啟用時填入 ───────────────
GEMINI_API_KEY=

# ── Email 寄送：任務 5.8（Resend）啟用時填入 ───────────────
# Resend → API Keys；EMAIL_FROM 格式如 "BizMate <onboarding@resend.dev>"
# （共用測試網域；正式網域 SPF/DKIM 待部署前設定，見 PRD §14.2）
RESEND_API_KEY=
EMAIL_FROM=

# ── agent-service（Python）：A0 起 ────────────────────────
# 本機開發：先啟動 agent-service（見 agent-service/README.md），
#   AGENT_SERVICE_URL=http://127.0.0.1:8000
# Vercel 部署：Services 模式下為同域路徑前綴，
#   AGENT_SERVICE_URL=https://<你的網域>/agent-service
#
# INTERNAL_SERVICE_SECRET 為兩個服務共用，**兩邊必須設成同一個值**
# （Next.js 專案與 agent-service 各設一次）。至少 16 字元。
# 產生方式：openssl rand -base64 32
# 未設定時系統會自動 fallback 到不經 agent 的既有流程，不會壞掉。
AGENT_SERVICE_URL=
INTERNAL_SERVICE_SECRET=

# ── Agent feature flag：A4 起 ─────────────────────────────
# **預設關閉。** 只有明確設為 "true" 才啟用 tool-calling agent；
# 其他任何值（含 "1"、"yes"、"TRUE"）都視為關閉。
#
# 關閉時系統走與 agent 化之前完全相同的路徑。
#
# A6 對照已於 2026-08-17 完成：硬門檻（幻覺率 0%、fallback 率 0%）通過，但 agent
# 在品質上沒有優於單步流程，成本 2.8 倍、延遲 1.9 倍，且客戶被問的題數反而上升。
# **依該結論此旗標維持關閉。** 完整分析見 docs/agent-eval-a6-comparison.md。
AGENT_LOOP_ENABLED=

# ── E2E 測試：pnpm test:e2e ───────────────────────────────
# 金路徑最後一步會寄出真實報價單，需指定收件地址。
#
# Resend 網域尚未驗證，EMAIL_FROM 目前為共用測試地址 onboarding@resend.dev，
# 該模式下 Resend **只允許寄給 Resend 帳號持有人的信箱**，填其他地址一律被拒。
# 故此處請填你自己註冊 Resend 用的信箱。
VERIFY_EMAIL_RECIPIENT=
