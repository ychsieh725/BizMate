# BizMate 環境變數範本（SDS §15）
# 複製此檔為 .env.local 並填入實際值；.env.local 已被 gitignore，不會進版控。
# 分階段填入：現在只需要 Supabase 兩項，其餘功能任務啟動時再補。

# ── 核心：現在就需要（任務 2.2 起）─────────────────────────
# Supabase → Project Settings → Data API / API Keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM：任務 2.5（Gemini client）啟用時填入 ───────────────
GEMINI_API_KEY=

# ── LINE 終審：P1 任務 4.6 啟用時填入 ──────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── Email 寄送：P1 任務 4.11 啟用時填入 ────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Dashboard 保護：P2 任務 5.3 啟用時填入 ─────────────────
ADMIN_SECRET=
